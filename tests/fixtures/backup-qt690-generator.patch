+// 产品保证：兼容样本由Qt6.9实际旧实现生成，内容仅包含明确的虚构任务和偏好。
+void BackupServiceTests::generateQt69CompatibilityFixture()
+{
+    QCOMPARE(QString::fromLatin1(qVersion()), QStringLiteral("6.9.0"));
+    QSettings settings(settingsPath(), QSettings::IniFormat);
+    settings.setValue(QStringLiteral("focus/workMinutes"), 37);
+    settings.setValue(QStringLiteral("appearance/compatBool"), true);
+    settings.setValue(QStringLiteral("appearance/compatUnicode"), QStringLiteral("旧SDK学习👩‍💻\n虚构数据"));
+    settings.setValue(QStringLiteral("appearance/compatInteger"), QVariant::fromValue(qlonglong(-1234567890123LL)));
+    settings.setValue(QStringLiteral("appearance/compatReal"), 0.625);
+    settings.sync();
+    QCOMPARE(settings.status(), QSettings::NoError);
+    const int id = insertTask(QStringLiteral("Qt6.9虚构兼容任务"));
+    QVERIFY(id > 0);
+    QVERIFY(insertFocusSession(id, 1500));
+    const QString output = qEnvironmentVariable("POMODORO_QT69_FIXTURE_OUTPUT");
+    QVERIFY(!output.isEmpty());
+    QVERIFY(!QFileInfo::exists(output));
+    QVERIFY(BackupService::instance()->createBackup(output));
+    const auto info = BackupService::instance()->readBackupInfo(output);
+    QVERIFY2(info.value(QStringLiteral("valid")).toBool(), qPrintable(info.value(QStringLiteral("reason")).toString()));
+    QCOMPARE(info.value(QStringLiteral("taskCount")).toInt(), 1);
+    QCOMPARE(info.value(QStringLiteral("sessionCount")).toInt(), 1);
+}
